generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//
// ───────────────── USERS ─────────────────
//
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  image         String?
  avatarUrl          String?   @map("avatar_url")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  attributes      UserAttribute[]
  dimensionInputs DimensionInput[]
  lifeStates      LifeState[]
  lifeEvents      LifeEvent[]
  goals           Goal[]
  chatSessions    ChatSession[]
  suggestedPaths  SuggestedPath[]
  baseCommitments BaseCommitment[]
  postIts         PostIt[]
  dailyTasks      DailyTask[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @map("user_id") @db.ObjectId
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model BaseCommitment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  title String // e.g., "Trabajo", "Universidad"
  type  String // work, study, routine

  // Schedule
  daysOfWeek   Int[] // 0-6 (Sunday to Saturday)
  startTime    String? // e.g., "09:00"
  endTime      String? // e.g., "17:00"
  hoursPerDay  Float   @default(8)
  commuteHours Float? // e.g., 1.5

  dimensionId String?    @map("dimension_id") @db.ObjectId
  dimension   Dimension? @relation(fields: [dimensionId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("base_commitments")
}

// ... (intermediate models)

//
// ───────────────── SUGGESTED PATHS ─────────────────
//
model SuggestedPath {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  title           String
  emoji           String
  alignment       Int
  tagline         String
  description     String?
  dimensionName   String?  @map("dimension_name")
  reasons         String[]
  starterQuestion String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("suggested_paths")
}

//
// ───────────────── DIMENSIONS ─────────────────
//
model Dimension {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  label       String
  category    String // identity, capital, experience
  description String?

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attributes      UserAttribute[]
  dimensionInputs DimensionInput[]
  baseCommitments BaseCommitment[]
  lifeEvents      LifeEvent[]

  @@map("dimensions")
}

//
// ───────────────── USER ATTRIBUTES ─────────────────
//
model UserAttribute {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  userId      String @map("user_id") @db.ObjectId
  dimensionId String @map("dimension_id") @db.ObjectId

  name     String
  category String // value, skill, interest, etc
  metadata Json? // { level, frequency, importance }

  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension Dimension @relation(fields: [dimensionId], references: [id])

  @@map("user_attributes")
}

//
// ───────────────── DIMENSION INPUTS ─────────────────
//
model DimensionInput {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  userId      String @map("user_id") @db.ObjectId
  dimensionId String @map("dimension_id") @db.ObjectId

  inputType String // habit, mood, learning, event
  subType   String?

  valueJson Json @map("value_json")

  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension Dimension @relation(fields: [dimensionId], references: [id])

  @@map("dimension_inputs")
}

//
// ───────────────── LIFE STATE ─────────────────
//
model LifeState {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  lifeScore      Float @map("life_score")
  balanceScore   Float @map("balance_score")
  alignmentScore Float @map("alignment_score")
  energyIndex    Float @map("energy_index")

  timestamp   DateTime @default(now())
  triggeredBy String?  @map("triggered_by")

  insights Json?

  scores DimensionScore[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("life_states")
}

type DimensionScore {
  dimensionId String @db.ObjectId
  score       Float
  trend       String @default("stable")
  confidence  Float?
}

//
// ───────────────── LIFE EVENTS ─────────────────
//
model LifeEvent {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  type        String
  title       String
  description String?

  date   DateTime
  impact Json?

  dimensionId String?    @map("dimension_id") @db.ObjectId
  dimension   Dimension? @relation(fields: [dimensionId], references: [id])

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("life_events")
}

//
// ───────────────── GOALS (RAMAS) ─────────────────
//
model Goal {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  title       String
  description String?

  dimensionId String? @map("dimension_id") @db.ObjectId

  // 🎯 outcome
  target   Json?
  deadline DateTime?

  // ⚙️ contexto
  constraints Json? // { timePerWeek, budget, energy }

  // 📊 inteligencia
  readinessScore Float? @map("readiness_score")
  alignmentScore Float? @map("alignment_score")

  progress Float  @default(0)
  status   String @default("active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions GoalAction[]

  @@map("goals")
}

//
// ───────────────── GOAL ACTIONS (SISTEMA FLEXIBLE) ─────────────────
//
model GoalAction {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  goalId String @map("goal_id") @db.ObjectId

  title       String
  description String?

  // 🔥 clave
  type String // phase | task | habit | milestone

  parentId   String?      @map("parent_id") @db.ObjectId
  parent     GoalAction?  @relation("SubActions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subActions GoalAction[] @relation("SubActions")

  isCompleted Boolean @default(false) @map("is_completed")

  startDate  DateTime? @map("start_date")
  targetDate DateTime? @map("target_date")
  dimensions String[]
  attributes String[]

  // 🔁 hábitos
  frequency   Json? // { type: daily/weekly, value: number }
  streak      Int? // opcional
  consistency Float? // %

  // ⚙️ ejecución
  effort         Int? // 1–5
  estimatedHours Float?   @map("estimated_hours")
  dependsOn      String[] @map("depends_on") // ids de otras actions

  impact Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("goal_actions")
}

//
// ───────────────── TASKS (SUBPASOS OPCIONALES) ─────────────────
//
model Task {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  goalActionId String @map("goal_action_id") @db.ObjectId

  title       String
  description String?

  isCompleted Boolean @default(false) @map("is_completed")

  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  estimatedHours Float?    @map("estimated_hours")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  goalAction GoalAction @relation(fields: [goalActionId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

//
// ───────────────── CHAT ─────────────────
//
model ChatSession {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @map("user_id") @db.ObjectId
  context String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model ChatMessage {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String @map("session_id") @db.ObjectId

  role    String
  content String

  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

//
// ───────────────── POST-ITS (TABLERO) ─────────────────
//
model PostIt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  content   String
  color     String   @default("yellow")
  x         Float    @default(0) // Para arrastrar
  y         Float    @default(0) // Para arrastrar
  rotation  Float    @default(0) // Rotación orgánica
  zIndex    Int      @default(0)
  isPinned  Boolean  @default(false) @map("is_pinned")
  anchoredDate DateTime? @map("anchored_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_its")
}

//
// ───────────────── DAILY TASKS (AGENDA RÁPIDA) ─────────────────
//
model DailyTask {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @map("user_id") @db.ObjectId
  title          String
  isCompleted    Boolean  @default(false) @map("is_completed")
  date           DateTime // La fecha para la que se creó o a la que se arrastró
  estimatedHours Float?   @map("estimated_hours") // Opcional, tiempo estimado

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_tasks")
}
