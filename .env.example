# ============================================================
# BEAN — Life Intelligence Platform
# Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================================

# ----- Application -----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BEAN

# ----- Database (MongoDB Atlas) -----
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<tu_usuario>:<tu_password>@<tu_cluster>.mongodb.net/bean_db?retryWrites=true&w=majority"
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2048

# ----- DeepSeek (Branch Agents — active for testing) -----
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# ----- Authentication (Auth.js / NextAuth) -----
AUTH_SECRET=your-auth-secret-here # Required for Auth.js v5
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ----- AI Engine Service (Python FastAPI — future) -----
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=your-ai-engine-api-key

# ----- Azure (Production) — optional -----
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_STORAGE_CONNECTION_STRING=

# ----- Monitoring — optional -----
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=

# ----- Langfuse Observability -----
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
