generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated-prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//
// ───────────────── USERS ─────────────────
//
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attributes       UserAttribute[]
  dimensionInputs  DimensionInput[]
  lifeStates       LifeState[]
  lifeEvents       LifeEvent[]
  goals            Goal[]
  chatSessions     ChatSession[]
  suggestedPaths   SuggestedPath[]
  baseCommitments  BaseCommitment[]

  @@map("users")
}

model BaseCommitment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId @map("user_id")
  
  title       String   // e.g., "Trabajo", "Universidad"
  type        String   // work, study, routine
  
  // Schedule
  daysOfWeek  Int[]    // 0-6 (Sunday to Saturday)
  startTime   String?  // e.g., "09:00"
  endTime     String?  // e.g., "17:00"
  hoursPerDay Float    @default(8)
  commuteHours Float?  // e.g., 1.5
  
  dimensionId String?  @db.ObjectId @map("dimension_id")
  dimension   Dimension? @relation(fields: [dimensionId], references: [id])
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@map("base_commitments")
}

// ... (intermediate models)

//
// ───────────────── SUGGESTED PATHS ─────────────────
//
model SuggestedPath {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId @map("user_id")

  title         String
  emoji         String
  alignment     Int
  tagline       String
  description   String?
  dimensionName String?   @map("dimension_name")
  reasons       String[]
  starterQuestion String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("suggested_paths")
}

//
// ───────────────── DIMENSIONS ─────────────────
//
model Dimension {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  label       String
  category    String   // identity, capital, experience
  description String?

  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attributes       UserAttribute[]
  dimensionInputs  DimensionInput[]
  baseCommitments  BaseCommitment[]
  lifeEvents       LifeEvent[]

  @@map("dimensions")
}

//
// ───────────────── USER ATTRIBUTES ─────────────────
//
model UserAttribute {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId @map("user_id")
  dimensionId String   @db.ObjectId @map("dimension_id")

  name        String
  category    String   // value, skill, interest, etc
  metadata    Json?    // { level, frequency, importance }

  createdAt   DateTime @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id])
  dimension   Dimension @relation(fields: [dimensionId], references: [id])

  @@map("user_attributes")
}

//
// ───────────────── DIMENSION INPUTS ─────────────────
//
model DimensionInput {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId @map("user_id")
  dimensionId String   @db.ObjectId @map("dimension_id")

  inputType   String   // habit, mood, learning, event
  subType     String?

  valueJson   Json     @map("value_json")

  source      String   @default("manual")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id])
  dimension   Dimension @relation(fields: [dimensionId], references: [id])

  @@map("dimension_inputs")
}

//
// ───────────────── LIFE STATE ─────────────────
//
model LifeState {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId @map("user_id")

  lifeScore      Float    @map("life_score")
  balanceScore   Float    @map("balance_score")
  alignmentScore Float    @map("alignment_score")
  energyIndex    Float    @map("energy_index")

  timestamp      DateTime @default(now())
  triggeredBy    String?  @map("triggered_by")

  insights       Json?

  scores         DimensionScore[]

  user           User @relation(fields: [userId], references: [id])

  @@map("life_states")
}

type DimensionScore {
  dimensionId String @db.ObjectId
  score       Float
  trend       String @default("stable")
  confidence  Float?
}

//
// ───────────────── LIFE EVENTS ─────────────────
//
model LifeEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId @map("user_id")

  type        String
  title       String
  description String?

  date        DateTime
  impact      Json?
  
  dimensionId String?  @db.ObjectId @map("dimension_id")
  dimension   Dimension? @relation(fields: [dimensionId], references: [id])

  metadata    Json?

  createdAt   DateTime @default(now()) @map("created_at")

  user        User @relation(fields: [userId], references: [id])

  @@map("life_events")
}

//
// ───────────────── GOALS (RAMAS) ─────────────────
//
model Goal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId @map("user_id")

  title       String
  description String?

  dimensionId String?  @db.ObjectId @map("dimension_id")

  // 🎯 outcome
  target      Json?
  deadline    DateTime?

  // ⚙️ contexto
  constraints Json?    // { timePerWeek, budget, energy }

  // 📊 inteligencia
  readinessScore Float? @map("readiness_score")
  alignmentScore Float? @map("alignment_score")

  progress    Float    @default(0)
  status      String   @default("active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id])
  actions     GoalAction[]

  @@map("goals")
}

//
// ───────────────── GOAL ACTIONS (SISTEMA FLEXIBLE) ─────────────────
//
model GoalAction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  goalId      String   @db.ObjectId @map("goal_id")

  title       String
  description String?

  // 🔥 clave
  type        String   // phase | task | habit | milestone

  parentId    String?  @db.ObjectId @map("parent_id")
  parent      GoalAction? @relation("SubActions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subActions  GoalAction[] @relation("SubActions")

  isCompleted Boolean  @default(false) @map("is_completed")

  startDate   DateTime? @map("start_date")
  targetDate  DateTime? @map("target_date")
  dimensions  String[]
  attributes  String[]

  // 🔁 hábitos
  frequency   Json?    // { type: daily/weekly, value: number }
  streak      Int?     // opcional
  consistency Float?   // %

  // ⚙️ ejecución
  effort      Int?     // 1–5
  estimatedHours Float? @map("estimated_hours")
  dependsOn   String[] @map("depends_on") // ids de otras actions

  impact      Json?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  goal        Goal @relation(fields: [goalId], references: [id])
  tasks       Task[]

  @@map("goal_actions")
}

//
// ───────────────── TASKS (SUBPASOS OPCIONALES) ─────────────────
//
model Task {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  goalActionId    String   @db.ObjectId @map("goal_action_id")

  title           String
  description     String?

  isCompleted     Boolean  @default(false) @map("is_completed")

  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  estimatedHours  Float?    @map("estimated_hours")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  goalAction      GoalAction @relation(fields: [goalActionId], references: [id])

  @@map("tasks")
}

//
// ───────────────── CHAT ─────────────────
//
model ChatSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId @map("user_id")
  context   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages  ChatMessage[]
  user      User @relation(fields: [userId], references: [id])

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @db.ObjectId @map("session_id")

  role      String
  content   String

  createdAt DateTime @default(now()) @map("created_at")

  session   ChatSession @relation(fields: [sessionId], references: [id])

  @@map("chat_messages")
}